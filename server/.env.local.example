# Local Environment Configuration
# Copy this file to .env.local and configure your values
# DO NOT commit .env.local to version control

# ============================================
# REQUIRED: Server Configuration
# ============================================

# Port the server listens on
PORT=3000

# Host address to bind to (127.0.0.1 for localhost only, 0.0.0.0 for all interfaces)
HOST=127.0.0.1

# Directory for data storage (campaigns, databases, etc.)
DATA_DIR=./data

# ============================================
# REQUIRED: Security
# ============================================

# Cookie signing secret (REQUIRED - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
COOKIE_SECRET=your-secret-here-replace-with-generated-value

# ============================================
# OPTIONAL: Logging & Development
# ============================================

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Environment mode (development or production)
NODE_ENV=development

# ============================================
# OPTIONAL: Security & Access Control
# ============================================

# Allow admin access from remote IPs (set to 'true' to allow, default is localhost only)
# ADMIN_ALLOW_REMOTE=false

# ============================================
# OPTIONAL: Hosted Mode Configuration
# ============================================

# Public base URL for CORS validation (e.g., https://yourdomain.com)
# PUBLIC_BASE_URL=

# Trust proxy headers (true, false, number, or comma-separated IPs)
# TRUST_PROXY=false

# ============================================
# OPTIONAL: Advanced Configuration
# ============================================

# Override client build path (default: auto-detected)
# CLIENT_DIST_PATH=../client/dist
